# Le due reti del deck, e sono le uniche a cui si collega.
wifi_ssid: "NomeDellaRete"
wifi_password: "passwordwifi"
# La seconda. Non lasciarla vuota: ESPHome rifiuta un SSID vuoto e con esso
# tutta la configurazione. Se non hai una seconda rete, tieni un segnaposto:
# il deck cerchera' una rete che non esiste e usera' la prima, senza danni.
wifi_ssid_ufficio: "NomeDellaSecondaRete"
wifi_password_ufficio: "passwordwifi2"
# Il token lo stampa `macdeck token` sul Mac
deck_token: "incolla qui il token dell'agent"
ota_password: "una password qualunque"
# 32 byte in base64: openssl rand -base64 32
api_key: "chiave base64 da 32 byte"
